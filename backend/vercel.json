{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/demo/run",
      "destination": "/api/demo-run"
    },
    {
      "source": "/api/diagnostics/full-workflow-7a1c",
      "destination": "/api/full-workflow"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
